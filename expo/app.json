{
  "expo": {
    "name": "SwedBank",
    "slug": "swedbank",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "swedbank",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "splash": {
      "backgroundColor": "#0F2A5C"
    },

    "web": {
      "favicon": "./assets/images/favicon.png"
    },

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.swedbank",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow $(PRODUCT_NAME) to access your Face ID biometric data.",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photos",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F2A5C"
      },
      "package": "app.rork.swedbank",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },

    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends.",
          "cameraPermission": "The app accesses your camera to let you take profile photos."
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#0F2A5C",
          "defaultChannel": "default"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    }
  }
}